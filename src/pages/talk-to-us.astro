---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import { CONTACT } from "../data/site";

const whatsappUrl = `https://wa.me/${CONTACT.whatsapp.phone}?text=${encodeURIComponent(CONTACT.whatsapp.message)}`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${CONTACT.address.city}, ${CONTACT.address.country}`)}`;
const card =
  "group bg-white rounded-3xl border border-slate-100 shadow-xl shadow-slate-200/50 p-8 md:p-10 flex flex-col hover:-translate-y-1 transition-all duration-500 hover:shadow-2xl";
---

<BaseLayout
  title="Contactez Nafuu | WhatsApp, email et adresse à Bunia"
  description="Une question, une suggestion ou un souci avec votre commande ? Contactez l'équipe Nafuu sur WhatsApp, par email ou à notre bureau de Bunia, Ituri."
>
  <div class="min-h-screen flex flex-col">
    <Navbar isDark />
    <div class="grow">
      <div class="min-h-screen bg-white">
        <header class="bg-slate-900 pt-32 pb-24 px-6 md:px-12 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-96 h-96 bg-orange-600/10 rounded-full -translate-y-1/2 translate-x-1/3 blur-3xl"></div>
          <div class="absolute bottom-0 left-0 w-64 h-64 bg-green-500/5 rounded-full translate-y-1/2 -translate-x-1/4 blur-3xl"></div>
          <div class="max-w-7xl mx-auto relative z-10">
            <p class="text-orange-500 font-bold uppercase tracking-[0.2em] text-xs mb-6">Nous sommes à votre écoute</p>
            <h1 class="text-5xl md:text-[100px] font-black text-white tracking-tighter leading-none mb-6">
              Parlez-<span class="text-orange-600">nous</span>
            </h1>
            <p class="text-slate-400 text-base md:text-lg max-w-xl font-medium leading-relaxed">
              Une question, une suggestion ou un souci avec votre commande ? Choisissez le canal qui vous convient. Nous vous répondons rapidement.
            </p>
          </div>
        </header>

        <section class="max-w-7xl mx-auto px-6 md:px-12 -mt-12 relative z-20 pb-24">
          <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
            <article class={`${card} hover:shadow-green-100/50`}>
              <div class="w-16 h-16 rounded-2xl bg-green-50 flex items-center justify-center mb-8 group-hover:scale-110 transition-transform duration-500">
                <Icon name="fa6-brands:whatsapp" class="text-green-500 text-3xl" />
              </div>
              <span class="text-xs font-bold uppercase tracking-widest text-green-600 mb-2">Réponse rapide</span>
              <h2 class="text-2xl font-black text-slate-900 mb-3">WhatsApp</h2>
              <p class="text-slate-500 text-sm leading-relaxed mb-8 grow">
                Discutez directement avec un agent de notre équipe support. Idéal pour les questions urgentes ou le suivi d'une commande.
              </p>
              <p class="text-slate-900 font-bold text-lg mb-6">{CONTACT.whatsapp.display}</p>
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-3 w-full py-4 px-6 bg-green-500 hover:bg-green-600 text-white font-bold rounded-xl transition-all duration-300 active:scale-95 shadow-lg shadow-green-500/25 hover:shadow-green-500/40"
              >
                <Icon name="fa6-brands:whatsapp" class="text-xl" />
                Écrire sur WhatsApp
              </a>
            </article>

            <article class={`${card} hover:shadow-orange-100/50`}>
              <div class="w-16 h-16 rounded-2xl bg-orange-50 flex items-center justify-center mb-8 group-hover:scale-110 transition-transform duration-500">
                <Icon name="fa6-solid:envelope" class="text-orange-600 text-2xl" />
              </div>
              <span class="text-xs font-bold uppercase tracking-widest text-orange-600 mb-2">Réponse sous 24h</span>
              <h2 class="text-2xl font-black text-slate-900 mb-3">Email</h2>
              <p class="text-slate-500 text-sm leading-relaxed mb-8 grow">
                Pour les demandes détaillées, les réclamations ou les partenariats, envoyez-nous un message par email.
              </p>
              <p class="text-slate-900 font-bold text-lg mb-6 break-all">{CONTACT.email}</p>
              <div class="flex flex-col sm:flex-row gap-3">
                <a
                  href={`mailto:${CONTACT.email}`}
                  class="inline-flex items-center justify-center gap-2 flex-1 py-4 px-6 gradient-primary text-white font-bold rounded-xl transition-all duration-300 active:scale-95 shadow-lg shadow-orange-500/25 hover:shadow-orange-500/40"
                >
                  <Icon name="fa6-solid:paper-plane" class="text-sm" />
                  Envoyer un email
                </a>
                <button
                  type="button"
                  id="copy-email"
                  data-email={CONTACT.email}
                  aria-label="Copier l'adresse email"
                  class="inline-flex items-center justify-center gap-2 py-4 px-6 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl transition-all duration-300 active:scale-95"
                >
                  <Icon name="fa6-solid:copy" data-copy-icon="idle" />
                  <Icon name="fa6-solid:check" class="text-green-600 hidden" data-copy-icon="done" />
                  <span data-copy-label>Copier</span>
                </button>
              </div>
            </article>

            <article class={`${card} hover:shadow-slate-200/80`}>
              <div class="w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center mb-8 group-hover:scale-110 transition-transform duration-500">
                <Icon name="fa6-solid:location-dot" class="text-slate-700 text-2xl" />
              </div>
              <span class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-2">Notre bureau</span>
              <h2 class="text-2xl font-black text-slate-900 mb-3">Adresse</h2>
              <p class="text-slate-500 text-sm leading-relaxed mb-8 grow">Nafuu est né et opère à Bunia.</p>
              <address class="not-italic text-slate-900 font-bold leading-relaxed mb-6">
                {CONTACT.address.company}<br />
                {CONTACT.address.city}<br />
                {CONTACT.address.country}
              </address>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-3 w-full py-4 px-6 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl transition-all duration-300 active:scale-95"
              >
                <Icon name="fa6-solid:diamond-turn-right" class="text-sm" />
                Voir sur la carte
              </a>
            </article>
          </div>

          <div class="mt-12 bg-slate-50 border border-slate-100 rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-4 text-center md:text-left">
              <div class="w-12 h-12 rounded-xl bg-orange-100 flex items-center justify-center shrink-0">
                <Icon name="fa6-solid:clock" class="text-orange-600" />
              </div>
              <div>
                <p class="font-black text-slate-900">Horaires de disponibilité</p>
                <p class="text-slate-500 text-sm">{CONTACT.hours}</p>
              </div>
            </div>
            <p class="text-slate-400 text-sm text-center md:text-right max-w-sm">
              WhatsApp reste le moyen le plus rapide pour obtenir une réponse en dehors des heures de bureau.
            </p>
          </div>
        </section>
      </div>
    </div>
    <Footer />
  </div>
</BaseLayout>

<script>
  const button = document.getElementById("copy-email");
  if (button) {
    const email = button.dataset.email ?? "";
    const label = button.querySelector("[data-copy-label]");
    const idle = button.querySelector('[data-copy-icon="idle"]');
    const done = button.querySelector('[data-copy-icon="done"]');
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(email);
        idle?.classList.add("hidden");
        done?.classList.remove("hidden");
        if (label) label.textContent = "Copié !";
        setTimeout(() => {
          idle?.classList.remove("hidden");
          done?.classList.add("hidden");
          if (label) label.textContent = "Copier";
        }, 2000);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  }
</script>
