---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/layout/Footer.astro";
import { LINKS } from "../data/site";
---

<BaseLayout title="Page introuvable | Nafuu" description="Cette page n'existe pas ou a été déplacée." hideScrollTop noindex>
  <div class="min-h-screen flex flex-col">
    <main class="grow bg-slate-50 flex flex-col items-center justify-center p-6 text-center min-h-[80vh]">
      <a href="/" aria-label="Nafuu, accueil" class="mb-12">
        <img src="/images/logo_nafuu_black.png" alt="Nafuu Logo" width="813" height="378" class="h-8 w-auto" />
      </a>
      <h1 class="text-5xl md:text-7xl font-black text-slate-900 mb-6 tracking-tight">
        Page <span class="text-orange-600">introuvable</span>
      </h1>
      <p class="text-slate-600 text-lg max-w-xl mb-10">
        Cette page n'existe pas ou a été déplacée. Vous cherchez votre espace restaurant ?
        Il se trouve désormais sur <a class="text-orange-600 font-bold hover:underline" href={LINKS.restaurantLogin}>app.nafuudelivery.com</a>.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-8 py-4 bg-white border-2 border-slate-200 rounded-md text-slate-900 hover:bg-slate-100 hover:border-slate-300 transition-all active:scale-95 shadow-sm"
      >
        <Icon name="fa6-solid:arrow-left" class="text-xs" />
        Retour à l'accueil
      </a>
    </main>
    <Footer />
  </div>
</BaseLayout>
