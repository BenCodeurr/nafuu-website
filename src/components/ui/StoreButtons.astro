---
import BrandIcon from "./BrandIcon.astro";
import { STORES } from "../../data/site";

interface Props {
  /** "dark": black buttons (hero). "light": white buttons on a dark section. */
  variant?: "dark" | "light";
}

const { variant = "dark" } = Astro.props;
---

{
  variant === "dark" ? (
    <>
      <a href={STORES.appStore} target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto bg-black text-white px-8 py-4 rounded-md flex items-center justify-center hover:bg-slate-800 transition-all shadow-xl group active:scale-95">
        <div class="mr-4 group-hover:scale-110 transition-transform">
          <BrandIcon name="apple" class="w-8 h-8 fill-current" />
        </div>
        <div class="text-left">
          <p class="text-[10px] uppercase font-semibold opacity-70">Téléchargez sur</p>
          <p class="text-lg font-bold leading-none">App Store</p>
        </div>
      </a>
      <a href={STORES.googlePlay} target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto bg-black text-white px-8 py-4 rounded-md flex items-center justify-center hover:bg-slate-800 transition-all shadow-xl group active:scale-95">
        <div class="mr-4 group-hover:scale-110 transition-transform">
          <BrandIcon name="google-play" class="w-7 h-7 fill-current" />
        </div>
        <div class="text-left">
          <p class="text-[10px] uppercase font-semibold opacity-70">Téléchargez sur</p>
          <p class="text-lg font-bold leading-none">Google Play</p>
        </div>
      </a>
    </>
  ) : (
    <>
      <a href={STORES.appStore} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 bg-white text-slate-900 px-8 py-4 rounded-md font-bold hover:bg-slate-100 transition-all shadow-xl active:scale-95 group">
        <BrandIcon name="apple" />
        <div class="text-left">
          <p class="text-[10px] uppercase font-bold opacity-60 leading-none mb-1">Téléchargez sur</p>
          <p class="text-lg leading-none">App Store</p>
        </div>
      </a>
      <a href={STORES.googlePlay} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 bg-white text-slate-900 px-8 py-4 rounded-md font-bold hover:bg-slate-100 transition-all shadow-xl active:scale-95 group">
        <BrandIcon name="google-play" />
        <div class="text-left">
          <p class="text-[10px] uppercase font-bold opacity-60 leading-none mb-1">Téléchargez sur</p>
          <p class="text-lg leading-none">Google Play</p>
        </div>
      </a>
    </>
  )
}
