---
import { Icon } from "astro-icon/components";

interface Props {
  /** Extra classes for the outer wrapper (height). */
  class?: string;
}

const { class: className = "min-h-screen" } = Astro.props;
---

<div class={`${className} bg-slate-50 flex flex-col items-center justify-center p-6 text-center`}>
  <div class="max-w-2xl animate-fade-in">
    <div class="w-20 h-20 bg-orange-100 rounded-md flex items-center justify-center mx-auto mb-8 shadow-inner">
      <Icon name="fa6-solid:briefcase" class="text-orange-600 text-3xl" />
    </div>

    <h1 class="text-5xl md:text-7xl font-black text-slate-900 mb-6 tracking-tight">
      <slot name="title" />
    </h1>

    <p class="text-sm md:text-xl text-slate-600 leading-relaxed font-medium mb-12">
      <slot />
    </p>

    <a
      href="/"
      class="inline-flex items-center gap-2 px-8 py-4 bg-white border-2 border-slate-200 rounded-md text-slate-900 hover:bg-slate-100 hover:border-slate-300 transition-all active:scale-95 shadow-sm"
    >
      <Icon name="fa6-solid:arrow-left" class="text-xs" />
      Retour à l'accueil
    </a>
  </div>
</div>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 1s cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }
</style>
