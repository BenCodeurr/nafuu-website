---
import BrandIcon from "../ui/BrandIcon.astro";
import { SOCIAL, STORES } from "../../data/site";

const currentYear = new Date().getFullYear();
const socialClass =
  "w-10 h-10 bg-slate-800 rounded-md flex items-center justify-center hover:bg-orange-600 hover:text-white transition-all duration-300 shadow-lg hover:-translate-y-1";
const linkClass = "hover:text-orange-500 transition-colors";
---

<footer class="bg-slate-900 text-slate-300 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-12 mb-12">
      <div class="col-span-1 md:col-span-1">
        <div class="flex items-center mb-6">
          <img src="/images/logo_nafuu_black.png" alt="Nafuu Logo" width="813" height="378" loading="lazy" class="h-10 w-auto brightness-0 invert" />
        </div>
        <p class="text-sm leading-relaxed opacity-70 mb-6">
          Révolutionner la livraison de repas en connectant les saveurs locales au confort de votre foyer.
        </p>
        <div class="flex space-x-4">
          <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class={socialClass}>
            <BrandIcon name="facebook" />
          </a>
          <a href={SOCIAL.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" class={socialClass}>
            <BrandIcon name="tiktok" />
          </a>
          <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class={socialClass}>
            <BrandIcon name="linkedin" />
          </a>
        </div>
      </div>

      <div>
        <h2 class="text-white font-bold mb-6">Liens Rapides</h2>
        <ul class="space-y-4 text-sm">
          <li><a href="/" class={linkClass}>Accueil</a></li>
          <li><a href="/about" class={linkClass}>À propos de nous</a></li>
          <li><a href="/careers" class={linkClass}>Carrières</a></li>
          <li><a href="/talk-to-us" class={linkClass}>Contactez-nous</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-white font-bold mb-6">Partenariats</h2>
        <ul class="space-y-4 text-sm">
          <li><a href="/rider" class={linkClass}>Devenir Livreur</a></li>
          <li><a href="/restaurant" class={linkClass}>Inscrire un Restaurant</a></li>
          <li><a href="/entreprises" class={linkClass}>Solutions Entreprises</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-white font-bold mb-6">Télécharger l'App</h2>
        <div class="space-y-4">
          <a href={STORES.appStore} target="_blank" rel="noopener noreferrer" class="group flex bg-slate-800 p-3 rounded-md hover:bg-slate-700 transition-all items-center border border-transparent hover:border-slate-600">
            <BrandIcon name="apple" class="w-6 h-6 mr-3 text-white group-hover:scale-110 transition-transform fill-white" />
            <div>
              <p class="text-[10px] uppercase opacity-60 text-white">Téléchargez sur</p>
              <p class="text-sm font-bold text-white">App Store</p>
            </div>
          </a>
          <a href={STORES.googlePlay} target="_blank" rel="noopener noreferrer" class="group flex bg-slate-800 p-3 rounded-md hover:bg-slate-700 transition-all items-center border border-transparent hover:border-slate-600">
            <BrandIcon name="google-play" class="w-6 h-6 mr-3 text-white group-hover:scale-110 transition-transform fill-white" />
            <div>
              <p class="text-[10px] uppercase opacity-60 text-white">Téléchargez sur</p>
              <p class="text-sm font-bold text-white">Google Play</p>
            </div>
          </a>
        </div>
      </div>
    </div>

    <div class="pt-12 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center text-xs opacity-50">
      <p>© {currentYear} nafuu. Tous droits réservés.</p>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 mt-4 md:mt-0">
        <a href="/terms" class="hover:underline transition-colors hover:text-white">Conditions d'utilisation</a>
        <a href="/privacy" class="hover:underline transition-colors hover:text-white">Politique de confidentialité</a>
        <a href="/delete-account" class="hover:underline transition-colors hover:text-white">Supprimer mon compte</a>
      </div>
    </div>
  </div>
</footer>
