---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import StoreButtons from "../ui/StoreButtons.astro";
import pizza from "../../assets/images/pizza.jpg";

const phrases = ["Tu as faim ?", "Uko njala ?", "Are you hungry?", "Oza na nzala ?"];
---

<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden" data-reveal-group>
  <!-- Background decorative elements -->
  <div class="absolute top-0 right-0 -z-10 w-1/2 h-full bg-orange-50 rounded-bl-[100px] opacity-50 hidden lg:block"></div>
  <div class="absolute top-20 left-10 -z-10 w-64 h-64 bg-yellow-100 rounded-full blur-3xl opacity-30"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Text content -->
      <div class="text-center lg:text-left ease-out" data-reveal="up-lg">
        <h1
          id="hero-phrases"
          class="h-[120px] lg:h-[200px] relative overflow-hidden mb-12 flex items-center justify-center lg:justify-start text-6xl lg:text-8xl font-black text-orange-600 leading-tight"
          aria-label={`${phrases[0]} Nafuu, livraison de repas à Bunia`}
        >
          {
            phrases.map((phrase, index) => (
              <span
                aria-hidden="true"
                data-phrase
                class:list={[
                  "absolute transition-all duration-700 transform",
                  index === 0 ? "opacity-100 translate-y-0" : "opacity-0 translate-y-12",
                ]}
              >
                {phrase}
              </span>
            ))
          }
        </h1>

        <p class="text-[16px] text-slate-600 mb-12 max-w-2xl mx-auto lg:mx-0 leading-relaxed delay-500" data-reveal="up">
          Commande ton repas dans le restaurant de ton choix et nous te l'apporterons devant ta porte.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start space-y-4 sm:space-y-0 sm:space-x-4 delay-700" data-reveal="up">
          <StoreButtons />
        </div>

        <p class="mt-8 text-sm text-slate-500">* Commandez uniquement via l'application.</p>
      </div>

      <!-- Visual content -->
      <div class="relative flex justify-center delay-500" data-reveal="right">
        <div class="relative w-full max-w-md">
          <Image
            src={pizza}
            alt="App Nafuu Delivery"
            width={896}
            widths={[448, 896]}
            sizes="(min-width: 448px) 448px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="rounded-[40px] shadow-2xl border-8 border-white transform rotate-3 hover:rotate-0 transition-all duration-1000 ease-out object-cover aspect-4/5 w-full"
          />
          <!-- Floating cards -->
          <div class="absolute -left-6 bottom-20 bg-white p-4 rounded-md shadow-xl flex items-center animate-bounce space-x-3">
            <div class="w-10 h-10 bg-green-100 rounded-md flex items-center justify-center">
              <Icon name="fa6-solid:check" class="text-green-600" />
            </div>
            <div>
              <p class="text-sm font-bold">Livraison Rapide</p>
              <p class="text-xs text-slate-500">Suivi en temps reel</p>
            </div>
          </div>

          <div class="absolute -right-4 top-10 bg-white p-3 rounded-md shadow-lg flex items-center space-x-2">
            <Icon name="fa6-solid:star" class="text-yellow-400" />
            <span class="text-xs font-bold">Avis verifiés</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const phrases = document.querySelectorAll<HTMLElement>("#hero-phrases [data-phrase]");
  if (phrases.length > 1 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let current = 0;
    setInterval(() => {
      const previous = phrases[current];
      current = (current + 1) % phrases.length;
      const next = phrases[current];
      previous.classList.replace("opacity-100", "opacity-0");
      previous.classList.replace("translate-y-0", "translate-y-12");
      next.classList.replace("opacity-0", "opacity-100");
      next.classList.replace("translate-y-12", "translate-y-0");
    }, 3000);
  }
</script>
