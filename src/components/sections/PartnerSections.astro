---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import deliveryPerson from "../../assets/images/delivery_person.png";
import restaurantImg from "../../assets/images/restaurant_img.avif";

const cards = [
  {
    image: deliveryPerson,
    alt: "Livreur Nafuu à moto",
    tag: "Liberté",
    title: "Devenir Livreur",
    text: "Prenez le contrôle de votre temps. En tant que partenaire livreur chez nafuu, vous bénéficiez d'une flexibilité totale. Choisissez vos horaires, roulez quand vous le souhaitez et augmentez vos revenus hebdomadaires grâce à notre plateforme.",
    href: "/rider",
    cta: "Postulez maintenant",
    delay: "delay-300",
  },
  {
    image: restaurantImg,
    alt: "Partenaire Restaurant Nafuu",
    tag: "Expansion",
    title: "Devenir Partenaire",
    text: "Transformez votre cuisine en un moteur de croissance numérique. nafuu vous connecte à une vaste communauté de gourmets prêts à découvrir vos plats. Nous gérons la logistique et la visibilité pour que vous puissiez vous concentrer sur l'essentiel : créer des repas d'exception.",
    href: "/restaurant",
    cta: "Inscrire mon établissement",
    delay: "delay-500",
  },
];
---

<section id="partners-overview" class="py-24 bg-white overflow-hidden" data-reveal-group>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 space-y-6 md:space-y-0">
      <div class="max-w-3xl">
        <h2 class="text-6xl lg:text-8xl font-black text-slate-900 mb-6 leading-[0.9] tracking-tighter duration-700" data-reveal="up">
          Grandissez avec l'écosystème <span class="text-orange-500">nafuu</span>
        </h2>
        <p class="text-[16px] text-slate-600 leading-relaxed duration-700 delay-200" data-reveal="up">
          Que vous souhaitiez augmenter vos revenus ou étendre la portée de votre cuisine, nous avons les outils pour vous aider à réussir.
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-10">
      {
        cards.map((card) => (
          <div
            class={`group relative bg-slate-50 rounded-[40px] overflow-hidden border border-slate-100 ${card.delay} hover:shadow-[0_20px_50px_rgba(255,107,0,0.15)] hover:-translate-y-4 hover:border-orange-200`}
            data-reveal="up-lg"
          >
            <div class="h-80 overflow-hidden relative">
              <Image
                src={card.image}
                alt={card.alt}
                width={1280}
                widths={[640, 1280]}
                sizes="(min-width: 768px) 50vw, 100vw"
                class="w-full h-full object-cover transition-transform duration-1000 [transition-timing-function:cubic-bezier(0.23,1,0.32,1)] group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/20 to-transparent transition-opacity duration-500 group-hover:opacity-90" />
              <div class="absolute bottom-8 left-8 text-white">
                <div class="bg-orange-600 text-[10px] font-bold uppercase tracking-[0.2em] px-3 py-1.5 rounded-md mb-3 w-fit shadow-lg">{card.tag}</div>
                <h3 class="text-3xl font-bold">{card.title}</h3>
              </div>
            </div>
            <div class="p-10">
              <p class="text-slate-600 leading-relaxed mb-10 text-[16px]">{card.text}</p>
              <a
                href={card.href}
                class="w-full py-5 bg-white border-2 border-slate-200 text-slate-900 rounded-md font-bold hover:bg-orange-600 hover:text-white hover:border-orange-600 transition-all duration-300 flex items-center justify-center group/btn relative overflow-hidden"
              >
                <span class="relative z-10 flex items-center">
                  {card.cta}
                  <Icon name="fa6-solid:arrow-right" class="ml-3 transition-transform duration-300 group-hover/btn:translate-x-2" />
                </span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
